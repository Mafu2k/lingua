# ─────────────────────────────────────────────────────────────────────────────
# Translation provider
# ─────────────────────────────────────────────────────────────────────────────
# Optional. Leave empty to auto-select the best configured provider:
#   1. DeepL              if DEEPL_API_KEY is set            (recommended)
#   2. Google Cloud       if GOOGLE_TRANSLATE_API_KEY is set
#   3. Free fallback      unofficial Google endpoint + MyMemory (DEV ONLY)
#
# Force a specific provider with one of:
#   deepl | google-cloud | mymemory | google
#
# NOTE: the "google" (free, key-less) endpoint is unofficial and unsupported.
# For production, configure DEEPL_API_KEY or GOOGLE_TRANSLATE_API_KEY.
TRANSLATION_PROVIDER=

# DeepL API key — https://www.deepl.com/pro-api  (a free key ending in ":fx" works)
DEEPL_API_KEY=

# Google Cloud Translation API key — https://cloud.google.com/translate
GOOGLE_TRANSLATE_API_KEY=

# Optional contact email passed to MyMemory to raise the anonymous rate limit.
MYMEMORY_CONTACT_EMAIL=

# ─────────────────────────────────────────────────────────────────────────────
# Limits & tuning (optional — sensible defaults applied)
# ─────────────────────────────────────────────────────────────────────────────
MAX_TEXT_LENGTH=5000
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000
PROVIDER_TIMEOUT_MS=8000

# Public site URL, used for metadata/Open Graph (e.g. https://lingua.example.com)
NEXT_PUBLIC_SITE_URL=
